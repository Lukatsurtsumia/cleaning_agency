# Build artifacts and deps rebuilt inside the image
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Stale cached manifests from local dev — they reference dev-only packages
# (e.g. laravel/pail) that aren't in the --no-dev image, so let them regenerate.
/bootstrap/cache/*.php

# Local env & secrets — provided by Coolify at runtime
.env
.env.*
!.env.example

# VCS / tooling
.git
.gitignore
.gitattributes
.github

# Dev-only
/tests
phpunit.xml
compose.yaml
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
README.md
DEPLOY.md
CLAUDE.md
*.md

# OS cruft
.DS_Store
Thumbs.db
