# ---------------------------------------------------------------------------
# Coolify environment for Azur Clean Tinati.
# Paste ALL of this into: Coolify -> your app -> Environment Variables.
# Fill every blank marked "<--". Two secrets (APP_KEY, AGENDA_FEED_TOKEN) are
# deliberately kept out of this public repo — paste them from the deploy chat.
# ---------------------------------------------------------------------------

APP_NAME="Azur Clean Tinati"
APP_ENV=production
APP_KEY=                     # <-- paste the base64:... key from chat
APP_DEBUG=false
APP_URL=http://abdsrzja3fe8bwnblco44chs.168.119.254.233.sslip.io

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=                     # <-- Coolify MySQL: internal host / service name
DB_PORT=3306
DB_DATABASE=                 # <-- Coolify MySQL: database name
DB_USERNAME=                 # <-- Coolify MySQL: username
DB_PASSWORD=                 # <-- Coolify MySQL: password

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=                   # <-- your SMTP host (or leave blank for now)
MAIL_PORT=587
MAIL_USERNAME=               # <-- your SMTP username
MAIL_PASSWORD=               # <-- your SMTP password
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="contact@azurcleantinati.fr"
MAIL_FROM_NAME="Azur Clean Tinati"

AGENCY_EMAIL=tinababayan99@gmail.com
AGENDA_FEED_TOKEN=           # <-- paste the token from chat

ADMIN_NAME="Tina Babayan"
ADMIN_EMAIL=tinababayan99@gmail.com
ADMIN_PASSWORD=              # <-- choose a strong password for /login

# Host image (serversideup) boot tasks — do NOT remove.
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_MIGRATION=true
AUTORUN_LARAVEL_STORAGE_LINK=true
AUTORUN_LARAVEL_OPTIMIZE=true
