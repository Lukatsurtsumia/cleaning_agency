APP_NAME="Azur Clean Tinati"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://azurcleantinati.fr

# French-first, English available via the switcher.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cleaning_agency
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Booking/quote emails are queued. Run `php artisan queue:work` in production
# (see DEPLOY.md). Use `sync` only if you have no worker process.
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail — booking notifications. Fill in with a real SMTP provider before launch
# (e.g. Resend, Mailgun, or the host's SMTP). The FROM address must be on a
# domain you control, or messages will land in spam / be rejected.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="contact@azurcleantinati.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Where booking requests are sent. Defaults to MAIL_FROM_ADDRESS if left blank.
AGENCY_EMAIL="tinababayan99@gmail.com"

# Secret path for the private .ics agenda feed. Generate a long random value,
# e.g. `php artisan tinker --execute="echo bin2hex(random_bytes(20));"`
AGENDA_FEED_TOKEN=

VITE_APP_NAME="${APP_NAME}"
